<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ProfitLoss" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#315BCE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#172554</item>
        <item name="android:navigationBarColor">#F5F7FC</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.ProfitLoss.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#172554</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_profit_loss</item>
        <item name="postSplashScreenTheme">@style/Theme.ProfitLoss</item>
    </style>
</resources>
